---
import PageLayout from '../../layouts/PageLayout.astro';
import { Content } from '../../docs/azure-key-vault.md';
---

<PageLayout
  title="Azure Key Vault Integration"
  description="Use KrakenKey certificates with Azure Key Vault, App Service, and Container Apps. The private key stays in Key Vault; KrakenKey signs the CSR."
>
  <article class="section-container blog-post-content azure-guide">
    <div class="blog-post-header">
      <h1 class="section-title">Use KrakenKey certificates with Azure Key Vault, App Service, and Container Apps</h1>
    </div>
    <Content />
  </article>
</PageLayout>

<style>
  .azure-guide :global(details) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 0.75rem var(--space-md);
    margin-bottom: var(--space-md);
  }

  .azure-guide :global(summary) {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .azure-guide :global(details[open] summary) {
    margin-bottom: 0.75rem;
  }

  .azure-guide :global(details p:last-child) {
    margin-bottom: 0;
  }

  .azure-guide :global(blockquote) {
    font-style: normal;
  }
</style>

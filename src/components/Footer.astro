---
import { links } from '../data/links';

const currentYear = new Date().getFullYear();
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="header-logo footer-logo">
        <img src="/favicon.svg" alt="KrakenKey logo" width="64" height="64" />
        KrakenKey
      </a>
      <p>Automated TLS certificate management for developers and teams.</p>
    </div>

    <nav class="footer-columns" aria-label="Site">
      <div class="footer-links">
        <h4>Product</h4>
        <a href="/pricing">Pricing</a>
        <a href="/scanner">TLS Scanner</a>
        <a href="/roadmap">Roadmap</a>
        <a href="/blog">Blog</a>
      </div>

      <div class="footer-links">
        <h4>Get started</h4>
        <a href={links.signup}>Create an account</a>
        <a href={links.login}>Log in</a>
        <a href={links.quickStart}>Quick start</a>
        <a href={links.agentQuickStart}>Quick start for AI agents</a>
      </div>

      <div class="footer-links">
        <h4>Developers</h4>
        <a href="/docs/">Docs</a>
        <a href={links.apiReference}>API reference</a>
        <a href={links.cli}>CLI</a>
        <a href={links.githubAction} {...external}>GitHub Action</a>
        <a href={links.github} {...external}>GitHub</a>
        <a href={links.discussions} {...external}>Discussions</a>
      </div>

      <div class="footer-links">
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    &copy; {currentYear} KrakenKey LLC. All rights reserved.
  </div>
</footer>
